<Window x:Class="CustomScreenLocker.FirstRunLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Screen Locker - Language Setup"
        Icon="app.ico"
        Height="460" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}"
        Loaded="Window_Loaded">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 頂部歡迎標題 -->
            <RowDefinition Height="*"/>    <!-- 語言選擇列表 -->
            <RowDefinition Height="Auto"/> <!-- 底部確認按鈕 -->
        </Grid.RowDefinitions>

        <!-- 頂部歡迎標題 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="🌐" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Welcome to Screen Locker" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="Please select your display language (Default: English):" FontSize="13"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 中間語言卡片選項 -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="16,12"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LanguageListContainer">
                    <!-- 動態生成語言選項按鈕/單選框 -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底部確認按鈕 -->
        <Grid Grid.Row="2">
            <Button x:Name="BtnConfirm" Content="Get Started / Continue" Height="44"
                    Style="{StaticResource ModernButton}" FontSize="15"
                    Click="BtnConfirm_Click"/>
        </Grid>
    </Grid>
</Window>
