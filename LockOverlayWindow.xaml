<Window x:Class="CustomScreenLocker.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Locked"
        Icon="app.ico"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0D0E12"
        Cursor="Arrow"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.4" Duration="0:0:1.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 背景漸層底色 -->
        <Border x:Name="BackgroundGradientBorder" Background="#0D0E12"/>

        <!-- 裝飾微光效果 -->
        <Ellipse x:Name="GlowEllipseTop" Width="650" Height="650" Margin="-200,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Opacity="0.25" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowTopColor" Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="GlowEllipseBottom" Width="750" Height="750" Margin="0,0,-200,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowBottomColor" Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 頂部資訊列：常亮狀態指標與鎖定圖示 -->
        <Grid VerticalAlignment="Top" Margin="40,30,40,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                <TextBlock x:Name="AwakeStatusText" Text="螢幕常亮保護中 (不熄屏)" Foreground="#9CA3AF" FontSize="14" FontWeight="Medium"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLockSystemStatus" Text="🔒 系統鎖定保護" Foreground="#6B7280" FontSize="14" FontWeight="Medium"/>
            </StackPanel>
        </Grid>

        <!-- 中央主展示區 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 時鐘與日期 -->
                <RowDefinition Height="Auto"/> <!-- 自定義公告看板 -->
                <RowDefinition Height="Auto"/> <!-- 解鎖互動面板 -->
            </Grid.RowDefinitions>

            <!-- 1. 數位大時鐘與日期 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,36">
                <TextBlock x:Name="ClockText" Text="12:00:00"
                           Foreground="#FFFFFF" FontSize="84" FontWeight="Light"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="Segoe UI Light, Segoe UI, Microsoft JhengHei"/>
                <TextBlock x:Name="DateText" Text="2026 年 9 月 4 日 星期五"
                           Foreground="#9CA3AF" FontSize="20" FontWeight="Normal"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           FontFamily="Segoe UI, Microsoft JhengHei"/>
            </StackPanel>

            <!-- 2. 自定義訊息看板 -->
            <Border x:Name="NoticeCardBorder" Grid.Row="1" Background="#1E2028" CornerRadius="16" Padding="36,28"
                    BorderBrush="#2E3342" BorderThickness="1.5" Margin="0,0,0,32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 標籤 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock x:Name="NoticeTagText" Text="📢 留言告示" Foreground="#3B82F6" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 主要訊息內容 -->
                    <TextBlock x:Name="CustomMessageText"
                               Text="外出開會中，預計 14:00 返回，請勿關閉電腦。"
                               Foreground="#FFFFFF" FontSize="26" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="38" TextAlignment="Left"
                               FontFamily="Segoe UI, Microsoft JhengHei"/>

                    <!-- 次要訊息 / 聯絡方式 -->
                    <Border x:Name="ContactBorder" Margin="0,20,0,0" Padding="14,10"
                            Background="#262A35" CornerRadius="8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtContactPrefix" Text="📞 聯絡資訊：" Foreground="#9CA3AF" FontSize="15" FontWeight="Medium"/>
                            <TextBlock x:Name="ContactInfoText" Text="分機 8888 / 0912-345-678"
                                       Foreground="#E5E7EB" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 解鎖控制卡片 -->
            <Border x:Name="UnlockCardBorder" Grid.Row="2" Background="#171920" CornerRadius="14" Padding="28,20"
                    BorderBrush="#2B303C" BorderThickness="1.5" HorizontalAlignment="Center" MinWidth="420">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 提示文字 -->
                    <TextBlock x:Name="UnlockPromptText" Text="請輸入解鎖密碼"
                               Foreground="#D1D5DB" FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- 密碼輸入區 (有設定密碼時顯示) -->
                    <Grid x:Name="PasswordInputArea" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="UnlockPasswordBox" Height="42" FontSize="16"
                                     Style="{StaticResource ModernPasswordBox}"
                                     KeyDown="UnlockPasswordBox_KeyDown"
                                     VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="BtnUnlockSubmit" Grid.Column="1" Content="解鎖" Width="90" Height="42"
                                Style="{StaticResource ModernButton}" Click="BtnUnlock_Click"/>
                    </Grid>

                    <!-- 免密碼解鎖按鈕 (無設定密碼時顯示) -->
                    <Button x:Name="BtnDirectUnlock" Content="點擊解除鎖定" Height="44"
                            Style="{StaticResource ModernButton}" FontSize="15"
                            Click="BtnUnlock_Click" Visibility="Collapsed"/>

                    <!-- 錯誤提示 -->
                    <TextBlock x:Name="ErrorMsgText" Text="密碼錯誤，請重試"
                               Foreground="#EF4444" FontSize="13" FontWeight="Medium"
                               HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部說明提示 -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                   Text="Custom Screen Locker • 保持螢幕喚醒中" Foreground="#4B5563" FontSize="12"/>
    </Grid>
</Window>
