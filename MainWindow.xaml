<Window x:Class="CustomScreenLocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 自訂訊息防熄屏鎖屏器 (Custom Screen Locker)"
        Icon="app.ico"
        Height="730" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDark}"
        Visibility="Hidden"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 頂部標題與語言切換區 -->
            <RowDefinition Height="*"/>    <!-- 設定表單區 -->
            <RowDefinition Height="Auto"/> <!-- 操作按鈕區 -->
        </Grid.RowDefinitions>

        <!-- 頂部標題與語言選擇工具列 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左側標題與描述 -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="28" Height="28" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtAppTitle" Text="螢幕鎖定自訂器" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtAppSubtitle" Text="自訂離開告示、固定安全密碼，並透過 Windows API 原生阻止螢幕熄滅與休眠。"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 右側語言選擇器與自訂語言資料夾按鈕 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                <ComboBox x:Name="CmbLanguage" Width="140" Height="32" FontSize="12"
                          SelectionChanged="CmbLanguage_SelectionChanged" Margin="0,0,6,0"/>
                <Button x:Name="BtnOpenLocales" Content="📂" Width="32" Height="32" Padding="0"
                        Style="{StaticResource ModernButton}" Background="#2E3342" FontSize="14"
                        ToolTip="開啟自訂語言包資料夾 (Open Custom Locales Folder)"
                        Click="BtnOpenLocales_Click"/>
            </StackPanel>
        </Grid>

        <!-- 中間設定表單 (支援滾動) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <!-- 快捷範本 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPresetHeader" Text="常用鎖定模板 (點選套用 / 右鍵選單可快速呼叫)" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnSaveAsPreset" Content="➕ 儲存當前為模板"
                            Style="{StaticResource ModernButton}" Background="#252A36" Padding="10,4" FontSize="11"
                            Click="BtnSaveAsPreset_Click"/>
                </Grid>

                <WrapPanel x:Name="WrapPanelPresets" Margin="0,0,0,12">
                    <!-- 動態生成內建與自定義的模板按鈕 -->
                </WrapPanel>

                <!-- 自定義主要訊息 -->
                <TextBlock x:Name="TxtMsgHeader" Text="主要公告訊息 (顯示於螢幕中央)" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtCustomMessage" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}"
                         Text="外出開會中，預計 14:30 返回，請勿碰觸電腦。" Margin="0,0,0,14"/>

                <!-- 聯絡方式 / 補充資訊 -->
                <TextBlock x:Name="TxtContactHeader" Text="補充備註 / 聯絡方式 (選填)" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtContactInfo" Style="{StaticResource ModernTextBox}"
                         Text="分機 8888 / 緊急電話 0912-345-678" Margin="0,0,0,14"/>

                <!-- 解鎖密碼與固定密碼卡片 -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPwdHeader" Text="🔑 解鎖密碼設定" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPasswordBadge" Text="(已固定密碼保護)" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" Margin="8,1,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnClearPassword" Content="清除密碼" Padding="10,4"
                                    Style="{StaticResource ModernButton}" Background="#374151" FontSize="11"
                                    Click="BtnClearPassword_Click"/>
                        </Grid>

                        <!-- 密碼輸入框區 (支援切換查看) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PwdUnlock" Style="{StaticResource ModernPasswordBox}"
                                         VerticalContentAlignment="Center" Margin="0,0,6,0"
                                         PasswordChanged="PwdUnlock_PasswordChanged"/>
                            <TextBox x:Name="TxtUnlockPlain" Style="{StaticResource ModernTextBox}"
                                     VerticalContentAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                                     TextChanged="TxtUnlockPlain_TextChanged"/>
                            <Button Grid.Column="1" x:Name="BtnToggleShowPwd" Content="👁 顯示" Width="68"
                                    Style="{StaticResource ModernButton}" Background="#2E3342" FontSize="12"
                                    Click="BtnToggleShowPwd_Click"/>
                        </Grid>

                        <!-- 固定密碼勾選框 -->
                        <CheckBox x:Name="ChkFixedPassword" IsChecked="False" VerticalContentAlignment="Center"
                                  Checked="ChkFixedPassword_Changed" Unchecked="ChkFixedPassword_Changed">
                            <CheckBox.Content>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtFixedPwdCheckTitle" Text="固定此密碼 (保存至本機，每次打開自動載入套用)" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtFixedPwdCheckDesc" Text="免除每次鎖定重複輸入的麻煩；留空則為點擊即解鎖模式" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 背景主題選擇 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtThemeHeader" Text="鎖屏視覺主題 (可預覽即時配色)" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtThemeDesc" Grid.Column="1" Text="松柏墨綠 • 翡翠光暈" Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <ComboBox x:Name="CmbTheme" Height="36" Margin="0,0,0,10" SelectedIndex="0"
                          FontSize="13" SelectionChanged="CmbTheme_SelectionChanged">
                    <ComboBoxItem x:Name="ItemThemeForest" Content="🌲 翠綠幽靜森林 (Deep Forest)" Tag="Forest"/>
                    <ComboBoxItem x:Name="ItemThemePastoral" Content="🌾 春日田園麥浪 (Pastoral Meadow)" Tag="Pastoral"/>
                    <ComboBoxItem x:Name="ItemThemeSunset" Content="🌅 暮色落日餘暉 (Sunset Glow)" Tag="Sunset"/>
                    <ComboBoxItem x:Name="ItemThemeDeepOcean" Content="🌊 浩瀚深海蔚藍 (Deep Ocean)" Tag="DeepOcean"/>
                    <ComboBoxItem x:Name="ItemThemeAurora" Content="🔮 夢幻極光夜紫 (Aurora Purple)" Tag="AuroraPurple"/>
                    <ComboBoxItem x:Name="ItemThemeClassic" Content="🖤 曜石極致酷黑 (Classic Black)" Tag="ClassicBlack"/>
                </ComboBox>

                <!-- 即時主題配色預覽條 -->
                <Border x:Name="ThemePreviewBorder" Height="26" CornerRadius="6" Margin="0,0,0,14"
                        BorderThickness="1" BorderBrush="#374151">
                    <Grid>
                        <TextBlock x:Name="ThemePreviewLabel" Text="主題氛圍預覽"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 功能選項開關 -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="ChkKeepAwake" IsChecked="True" VerticalContentAlignment="Center">
                            <CheckBox.Content>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtKeepAwakeTitle" Text="保持螢幕常亮 (防止系統休眠與熄屏)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtKeepAwakeDesc" Text="透過 SetThreadExecutionState 原生驅動，不會被電源逾時關閉螢幕"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>

                        <CheckBox x:Name="ChkStartMinimized" IsChecked="True" VerticalContentAlignment="Center" Margin="0,10,0,0">
                            <CheckBox.Content>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtStartMinimizedTitle" Text="啟動時最小化至系統托盤 (不直接顯示主視窗)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtStartMinimizedDesc" Text="開啟時在右下角靜默待命，雙擊圖示或右鍵選單即可快速操作"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>

                        <CheckBox x:Name="ChkAutoStart" IsChecked="False" VerticalContentAlignment="Center" Margin="0,10,0,0"
                                  Click="ChkAutoStart_Click">
                            <CheckBox.Content>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock x:Name="TxtAutoStartTitle" Text="開機時自動啟動 (Windows 登入後自動執行)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtAutoStartDesc" Text="開機後直接常駐托盤，隨時為您提供離座鎖屏保護"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 鎖定延遲秒數 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,6">
                    <TextBlock x:Name="TxtDelayTitle" Text="鎖定延遲：" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbDelay0" Content="立即鎖定" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="10,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbDelay3" Content="3 秒倒數" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbDelay5" Content="5 秒倒數" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部主操作按鈕 -->
        <Grid Grid.Row="2">
            <Button x:Name="BtnStartLock" Content="🔒 立即進入鎖屏" Height="46"
                    Style="{StaticResource ModernButton}" FontSize="16"
                    Click="BtnStartLock_Click"/>
        </Grid>
    </Grid>
</Window>
